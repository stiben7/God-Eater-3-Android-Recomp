#version 450
// Built-in frame generation (lsfg/motion.cpp), 1: the frame's luma at the finest flow level, 1/scale of its size (2, 3
// or 4: the Quality). Each texel is the average of its scale x scale pixels: with an even scale, one bilinear tap in
// the middle of each 2x2 of them; with 3, each pixel.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r32f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; ivec2 src_size; vec2 inv_src; int flags; int scale; } p;

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.size.x || q.y >= p.size.y) return;
    int s = max(p.scale, 1);
    vec2 base = vec2(q * s);
    float sum = 0.0;
    int n = 0;
    if ((s & 1) == 0) {
        for (int y = 0; y < s; y += 2)
            for (int x = 0; x < s; x += 2, n++)
                sum += luma(textureLod(src, (base + vec2(x + 1, y + 1)) * p.inv_src, 0.0).rgb);
    } else {
        for (int y = 0; y < s; y++)
            for (int x = 0; x < s; x++, n++)
                sum += luma(textureLod(src, (base + vec2(x, y) + 0.5) * p.inv_src, 0.0).rgb);
    }
    imageStore(dst, q, vec4(sum / float(n)));
}
